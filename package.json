{
  "name": "@frixaco/letui",
  "version": "0.3.9",
  "license": "MIT",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "scripts/build-npm.ts"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build-ffi": "cd core && cargo build --release",
    "anitrack": "bun run build-ffi && bun run examples/anitrack.ts",
    "typecheck": "bun x tsc -p tsconfig.check.json",
    "check:rust": "cargo check --manifest-path core/Cargo.toml",
    "check": "bun run typecheck && bun run check:rust"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^25.5.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@frixaco/letui-darwin-arm64": "0.3.9",
    "@frixaco/letui-linux-x64": "0.3.9",
    "@frixaco/letui-win32-x64": "0.3.9"
  }
}
