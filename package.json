{
  "name": "@frixaco/letui",
  "version": "0.4.0",
  "license": "MIT",
  "files": [
    "index.ts",
    "src/**/*.ts",
    "taffy-ts/dist/**/*",
    "LICENSE"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build:taffy": "bun run --cwd taffy-ts build",
    "build:anitrack-binary": "bun run scripts/build-anitrack-binary.ts",
    "bench": "bun run bench/render.ts",
    "bench:anitrack": "bun run bench/anitrack.ts",
    "anki": "bun run examples/anki.ts",
    "anitrack": "bun run examples/anitrack.ts",
    "ai-agent": "bun run examples/ai-agent.ts",
    "fmt": "oxfmt . '!taffy-ts/**' '!dump/**'",
    "fmt-check": "oxfmt --check . '!taffy-ts/**' '!dump/**'",
    "lint": "oxlint --ignore-pattern 'taffy-ts/**' .",
    "smoke": "bun run scripts/smoke.ts",
    "snake": "bun run examples/snake.ts",
    "test": "bun test ./test",
    "typecheck": "bun x tsgo -p tsconfig.check.json",
    "visualizer": "bun run examples/visualizer.ts",
    "check": "bun run --cwd taffy-ts check && bun run typecheck && bun run lint && bun run test && bun run bench && bun run bench:anitrack && bun run smoke"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^24",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0"
  }
}
