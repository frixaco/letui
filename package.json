{
  "name": "@frixaco/letui",
  "version": "0.1.0",
  "license": "MIT",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "build-ffi": "cd letui-ffi && cargo build --release",
    "dev": "bun run build-ffi && bun run examples/hello-world.ts",
    "anitrack": "bun run build-ffi && bun run examples/anitrack.ts",
    "typecheck": "bun x tsc -p tsconfig.check.json",
    "check:rust": "cargo check --manifest-path letui-ffi/Cargo.toml",
    "smoke": "bun run build-ffi && bun run scripts/smoke.ts",
    "metrics:smoke": "bun run build-ffi && bun run scripts/capture-metrics.ts",
    "check": "bun run typecheck && bun run check:rust && bun run smoke"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/node": "^25.5.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "scripts/build-npm.ts"
  ],
  "optionalDependencies": {
    "@frixaco/letui-darwin-arm64": "0.1.0",
    "@frixaco/letui-linux-x64": "0.1.0",
    "@frixaco/letui-win32-x64": "0.1.0"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.116.0",
    "bun-ffi-structs": "^0.1.2",
    "shiki": "^4.0.2"
  }
}
